# ---------- Core ----------
SITE_URL=https://anavah-institute.org
TIMEZONE=America/New_York
SECRET_KEY=change-me-long-random-string          # signs unsubscribe links

# ---------- Supabase ----------
# Project Settings > Database > Connection string > "Session pooler" (port 5432 on the pooler host)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...                          # Project Settings > API > anon public
ADMIN_EMAILS=Scherb@anavah-institute.org,jjcesare86@gmail.com   # comma-separated allowlist

# ---------- Mia: text chat (Anthropic) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Mia: voice (ElevenLabs Agents) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
AGENT_WEBHOOK_SECRET=change-me                    # ElevenLabs tools send this as X-Agent-Secret

# ---------- Go High Level ----------
GHL_TOKEN=                                        # Private Integration Token
GHL_LOCATION_ID=
# Optional: notify Phillip through GHL when someone books
NOTIFY_EMAIL=Scherb@anavah-institute.org

# ---------- Outreach safety ----------
BUSINESS_ADDRESS=                                 # REQUIRED by CAN-SPAM before any email goes out
OUTREACH_DRY_RUN=true                             # keep true until you have tested; then set false
OUTREACH_DAILY_CAP=40

# ---------- Local dev only (never set in production) ----------
# DEV_ADMIN_TOKEN=dev

# ---------- Scheduling ----------
# google (default): everyone books an initial consultation on the Google Calendar page in config/practice.json.
# internal: turns the built-in Supabase calendar back on (dormant; needs BAAs before real patient data).
BOOKING_MODE=google
